{
  "name": "mirabilis-desktop",
  "version": "26.3.1",
  "description": "Mirabilis AI - Desktop App",
  "author": "Moshiko Nayman",
  "main": "main.js",
  "scripts": {
    "dev": "npx electron .",
    "verify:build": "node verify-build.js",
    "verify:release": "node verify-release.js"
  },
  "build": {
    "productName": "Mirabilis AI",
    "artifactName": "Mirabilis AI-${version}-${arch}.${ext}",
    "appId": "com.mirabilis.ai",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "updatePolicy.js",
      "icons/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/.next/standalone",
        "to": "frontend/.next/standalone",
        "filter": [
          "**/*",
          "!frontend/.next/cache/**/*"
        ]
      }
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "icons/Mirabilis.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "MoshikoNayman",
      "repo": "Mirabilis"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
