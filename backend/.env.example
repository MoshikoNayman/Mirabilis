# Mirabilis configuration. Copy to backend/.env and edit.
# Everything here is optional: the app runs with no configuration at all.
# Full reference: docs/CONFIGURATION.md

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=4000
# Leave the bind host alone unless an authenticating proxy sits in front: the
# API includes endpoints that run shell commands.
# MIRABILIS_BIND_HOST=127.0.0.1
# FRONTEND_ORIGIN=http://localhost:3000

# ── Storage ─────────────────────────────────────────────────────────────────
# Chats, IntelLedger, the vault, agent run logs and the MCP token.
# MIRABILIS_DATA_DIR=/absolute/path/to/mirabilis-data

# ── Local model ─────────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:12b

# ── Cloud or OpenAI-compatible ──────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_MODEL=model.gguf

# ── Web search (off without a key; always off under Go Dark) ────────────────
# TAVILY_API_KEY=

# ── Autonomous agent ────────────────────────────────────────────────────────
# Confine agent and MCP file tools to one subtree. Recommended before using the
# 1 hour or 5 hour tiers. Bounds file tools and where a command starts, not
# what a shell command can reach.
# MIRABILIS_MCP_FS_ROOT=/absolute/path/to/a/workspace
#
# Sub-agents generating at once. 2 is right for a single local engine.
# MIRABILIS_AGENT_FANOUT_CONCURRENCY=2
